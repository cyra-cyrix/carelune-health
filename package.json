{
  "name": "punarvaas-continuity",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "dev:marketing": "vite --mode marketing --config vite.marketing.config.ts --port 5175",
    "build": "npm run build:app && npm run build:marketing",
    "build:app": "vite build",
    "build:marketing": "vite build --mode marketing --config vite.marketing.config.ts",
    "preview:app": "vite preview --outDir dist/app --port 4180",
    "preview:marketing": "vite preview --outDir dist/marketing --port 4181",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify:separation": "node scripts/verify-separation.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.5.2",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.16",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3",
    "vite": "^6.0.7",
    "vitest": "^4.1.10"
  }
}
