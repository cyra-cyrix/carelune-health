# Netlify headers for drag-and-drop deploys.
#
# `netlify.toml` sits at the PROJECT root, so dragging `dist/` onto Netlify
# leaves it behind and none of its headers apply. This file lives in `public/`,
# which Vite copies verbatim into `dist/` on every build — so it travels with
# the folder you drag, and the headers apply without the CLI.
#
# Keep in sync with the [[headers]] blocks in netlify.toml.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  # This build is a fictional demonstration and must never be indexed as a
  # real clinical service.
  X-Robots-Tag: noindex, nofollow

/assets/*
  Cache-Control: public, max-age=31536000, immutable
