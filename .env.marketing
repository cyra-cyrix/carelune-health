# Marketing build (`vite build --mode marketing`). PUBLIC origins only — NO secrets.
# The app base is baked into the marketing bundle so "Sign in" points at the app
# even though the site is served from carelune.in. Netlify env vars override these.
VITE_APP_BASE_URL=https://app.carelune.in
VITE_MARKETING_BASE_URL=https://carelune.in
